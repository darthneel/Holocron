#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
ENV_FILE="$ROOT/../.env.local"
if [ -f "$ENV_FILE" ]; then
  set -a
  . "$ENV_FILE"
  set +a
fi

if [ -x /opt/homebrew/opt/ruby/bin/ruby ]; then
  DEFAULT_RUBY_BIN=/opt/homebrew/opt/ruby/bin/ruby
else
  DEFAULT_RUBY_BIN="$(command -v ruby)"
fi

RUBY_BIN="${RUBY_BIN:-$DEFAULT_RUBY_BIN}"
BUNDLE_BIN="$(dirname "$RUBY_BIN")/bundle"
TEST_DATABASE_URL="${TEST_DATABASE_URL:-postgres://localhost:5432/holocron_test}"
export PATH="$(dirname "$RUBY_BIN"):$PATH"

cd "$ROOT"
DATABASE_URL="$TEST_DATABASE_URL" "$BUNDLE_BIN" exec rake db:create >/dev/null
exec "$BUNDLE_BIN" exec "$RUBY_BIN" -Itest test/app_test.rb
