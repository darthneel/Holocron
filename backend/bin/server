#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
ENV_FILE="$ROOT/../.env.local"
if [ -f "$ENV_FILE" ]; then
  set -a
  . "$ENV_FILE"
  set +a
fi

if [ -x /opt/homebrew/opt/ruby/bin/ruby ]; then
  DEFAULT_RUBY_BIN=/opt/homebrew/opt/ruby/bin/ruby
else
  DEFAULT_RUBY_BIN="$(command -v ruby)"
fi

RUBY_BIN="${RUBY_BIN:-$DEFAULT_RUBY_BIN}"
SYSTEM_GEM_PATH="$($RUBY_BIN -rrubygems -e 'print Gem.path.join(":")')"

export GEM_HOME="$ROOT/vendor/gems"
export GEM_PATH="$GEM_HOME:$SYSTEM_GEM_PATH"
export PATH="$ROOT/vendor/bin:$(dirname "$RUBY_BIN"):$PATH"

cd "$ROOT"
if [ -x "$ROOT/vendor/bin/rackup" ]; then
  exec "$ROOT/vendor/bin/rackup" --server webrick --port "${PORT:-9292}" config.ru
else
  exec "$RUBY_BIN" -S bundle exec rackup --server webrick --port "${PORT:-9292}" config.ru
fi
