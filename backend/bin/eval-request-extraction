#!/bin/sh
set -eu

if [ "${RUN_LIVE_EVALS:-}" != "1" ]; then
  echo "Set RUN_LIVE_EVALS=1 to confirm that this command may make billed model requests." >&2
  exit 2
fi

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
ENV_FILE="$ROOT/../.env.local"
if [ -f "$ENV_FILE" ]; then
  set -a
  . "$ENV_FILE"
  set +a
fi

if [ "${AI_REQUEST_EXTRACTION_PROVIDER:-fake}" = "fake" ]; then
  echo "Configure a real AI_REQUEST_EXTRACTION_PROVIDER before running live evals." >&2
  exit 2
fi

if [ -x /opt/homebrew/opt/ruby/bin/ruby ]; then
  DEFAULT_RUBY_BIN=/opt/homebrew/opt/ruby/bin/ruby
else
  DEFAULT_RUBY_BIN="$(command -v ruby)"
fi

RUBY_BIN="${RUBY_BIN:-$DEFAULT_RUBY_BIN}"
SYSTEM_GEM_PATH="$($RUBY_BIN -rrubygems -e 'print Gem.path.join(":")')"

export GEM_HOME="$ROOT/vendor/gems"
export GEM_PATH="$GEM_HOME:$SYSTEM_GEM_PATH"

cd "$ROOT"
exec "$RUBY_BIN" -Ieval eval/request_extraction_eval_test.rb "$@"
