# frozen_string_literal: true

require "rake/testtask"
require_relative "lib/holocron/database"

namespace :db do
  desc "Create the PostgreSQL database"
  task :create do
    created = Holocron::Database.create!
    puts created ? "Created PostgreSQL database." : "PostgreSQL database already exists."
  end

  desc "Run database migrations"
  task :migrate do
    Holocron::Database.migrate!
  end

  desc "Load the fictional Cedar Grove office"
  task seed: :migrate do
    load File.expand_path("db/seeds.rb", __dir__)
  end

  desc "Seed a rolling two-week calendar for product demos"
  task seed_demo_calendar: :migrate do
    require_relative "script/seed_demo_calendar"
    Holocron::DemoCalendarSeed.run
  end

  desc "Create and seed the local database"
  task setup: %i[create seed]
end

Rake::TestTask.new do |task|
  task.libs << "test"
  task.pattern = "test/**/*_test.rb"
end

task default: :test
