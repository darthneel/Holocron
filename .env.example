# PostgreSQL. Keep real credentials in the ignored .env.local file.
DATABASE_URL=postgres://postgres@localhost:5432/holocron_development
TEST_DATABASE_URL=postgres://postgres@localhost:5432/holocron_test
PGPASSWORD=change-me
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=5

# The deterministic fake provider is the local and test default.
AI_REQUEST_EXTRACTION_PROVIDER=fake
AI_REQUEST_EXTRACTION_MODEL=fake-request-extractor-v1
AI_BRIEFING_GENERATION_PROVIDER=fake
AI_BRIEFING_GENERATION_MODEL=fake-briefing-generator-v1

# Recommended hosted gateway:
# AI_REQUEST_EXTRACTION_PROVIDER=vercel
# AI_REQUEST_EXTRACTION_MODEL=openai/gpt-5.6-luna
# AI_BRIEFING_GENERATION_PROVIDER=vercel
# AI_BRIEFING_GENERATION_MODEL=openai/gpt-5.6-terra
# AI_GATEWAY_API_KEY=

# Direct OpenAI alternative:
# AI_REQUEST_EXTRACTION_PROVIDER=openai
# AI_REQUEST_EXTRACTION_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=

# Optional OpenRouter alternative:
# AI_REQUEST_EXTRACTION_PROVIDER=openrouter
# AI_REQUEST_EXTRACTION_MODEL=openai/gpt-5.6-luna
# OPENROUTER_API_KEY=
